version: '3.8'

services:
  # SQL Server Database
  db:
    image: mcr.microsoft.com/mssql/server:2022-latest
    environment:
      SA_PASSWORD: "YourStrong@Passw0rd"
      ACCEPT_EULA: "Y"
    ports:
      - "1433:1433"
    volumes:
      - sqlserver_data:/var/opt/mssql
    networks:
      - reportflow-network
    healthcheck:
      test: ["CMD-SHELL", "/opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P 'YourStrong@Passw0rd' -Q 'SELECT 1'"]
      interval: 10s
      timeout: 5s
      retries: 5

  # .NET Client API
  client-api:
    build:
      context: ./Client
      dockerfile: Dockerfile
    ports:
      - "5000:8080"
    environment:
      - ASPNETCORE_ENVIRONMENT=Development
      - ConnectionStrings__DefaultConnection=Server=db,1433;Database=ReportFlowDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;
      - PythonApi__BaseUrl=http://python-api:8000
      - ClientApi__BaseUrl=http://client-api:8080
      - SharedPaths__Uploads=/shared/uploads
      - SharedPaths__Results=/shared/results
    volumes:
      - shared-data:/shared
    depends_on:
      db:
        condition: service_healthy
    networks:
      - reportflow-network

  # Python Processing API
  python-api:
    build:
      context: ./PythonApi
      dockerfile: Dockerfile
    ports:
      - "8000:8000"
    environment:
      - UPLOADS_DIR=/shared/uploads
      - RESULTS_DIR=/shared/results
      - CLIENT_API_BASE_URL=http://client-api:8080
      - LOG_LEVEL=INFO
    volumes:
      - shared-data:/shared
    depends_on:
      - client-api
    networks:
      - reportflow-network

volumes:
  sqlserver_data:
  shared-data:

networks:
  reportflow-network:
    driver: bridge




